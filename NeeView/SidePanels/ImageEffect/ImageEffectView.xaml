<UserControl x:Class="NeeView.ImageEffectView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
    xmlns:local="clr-namespace:NeeView"
    xmlns:nwp="clr-namespace:NeeView.Windows.Property"
    xmlns:nwc="clr-namespace:NeeView.Windows.Controls"
    xmlns:properties="clr-namespace:NeeView.Properties"
    mc:Ignorable="d" 
    d:DesignHeight="800" d:DesignWidth="300"
    MinWidth="200" 
    Focusable="True" FocusVisualStyle="{x:Null}"
    Foreground="{DynamicResource Panel.Foreground}">

    <UserControl.Resources>

        <ResourceDictionary>

            <local:PathToFileNameWithoutExtensionConverter x:Key="PathToFileNameWithoutExtensionConverter" />
            <local:StringNullOrWhiteSpaceToVisibilityConverter x:Key="StringNullOrWhiteSpaceToVisibilityConverter" True="Collapsed" False="Visible" />
            <local:NullableToVisibilityConverter x:Key="NullableToVisibilityConverter"/>

            <local:EffectUnitToSampleVisibilityConverter x:Key="EffectUnitToSampleVisibilityConverter"/>
            <local:EffectUnitToBushConverter x:Key="EffectUnitToBushConverter"/>
            <local:EffectUnitToEffectConverter x:Key="EffectUnitToEffectConverter"/>

            <DrawingImage x:Key="ic_toy_24px">
                <DrawingImage.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource g_rect24x24}" />
                        <GeometryDrawing Brush="Gray" Pen="{x:Null}" Geometry="{StaticResource g_toy_24px}" />
                    </DrawingGroup>
                </DrawingImage.Drawing>
            </DrawingImage>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <DataTemplate DataType="{x:Type nwp:PropertyValue_Boolean}">
                <CheckBox IsChecked="{Binding Value}" Content="{Binding Value}" />
            </DataTemplate>

            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
            </Style>

            <Style TargetType="nwc:EnterTriggerTextBox" BasedOn="{StaticResource NVEnterTriggerTextBox}">
                <EventSetter Event="KeyDown" Handler="Control_KeyDown_IgnoreSingleKeyGesture" />
            </Style>

            <Style TargetType="Separator" BasedOn="{StaticResource NVSeparator}">
                <Setter Property="Background" Value="{DynamicResource Panel.Separator}" />
                <Setter Property="Margin" Value="0,5" />
            </Style>

            <CollectionViewSource x:Key="ProfilesViewSource" Source="{Binding Path=Profiles}" IsLiveSortingRequested="True">
                <CollectionViewSource.SortDescriptions>
                    <scm:SortDescription />
                </CollectionViewSource.SortDescriptions>
            </CollectionViewSource>

        </ResourceDictionary>

    </UserControl.Resources>

    <DockPanel Margin="0,2" Background="Transparent">

        <DockPanel DockPanel.Dock="Top" Margin="0" KeyboardNavigation.TabNavigation="Local">

            <local:MoreMenuButton DockPanel.Dock="Right" Description="{Binding MoreMenuDescription}" VerticalAlignment="Center" TabIndex="2" />

            <ComboBox x:Name="EffectProfileComboBox" ItemsSource="{Binding Source={StaticResource ProfilesViewSource}}" SelectedItem="{Binding SelectedProfile}"
                    VerticalAlignment="Center" TabIndex="1">
                <ComboBox.Resources>
                    <DataTemplate DataType="{x:Type local:EffectProfile}">
                        <TextBlock x:Name="FileNameTextBlock" Text="{Binding DisplayName}"/>
                    </DataTemplate>
                </ComboBox.Resources>
                <ComboBox.InputBindings>
                    <KeyBinding Key="F2" Command="{Binding RenameProfileCommand}" />
                </ComboBox.InputBindings>
            </ComboBox>
        </DockPanel>

        <ScrollViewer x:Name="ScrollView" Style="{StaticResource NVScrollViewer}" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                CanContentScroll="False" Margin="2,0,0,0">

            <StackPanel Margin="2,10,0,10" RenderOptions.ClearTypeHint="{DynamicResource Window.ClearTypeHint}">

                <Separator />

                <DockPanel Margin="0,5">
                    <nwc:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding Source={x:Static local:Config.Current}, Path=ImageCustomSize.IsEnabled}"
                            VerticalAlignment="Center" />
                    <TextBlock Text="{properties:TextBinding Effect.CustomSize}" VerticalAlignment="Center" />
                </DockPanel>

                <StackPanel Margin="10,0,0,5" Visibility="{Binding Source={x:Static local:Config.Current}, Path=ImageCustomSize.IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel.Resources>
                        <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                        </Style>
                    </StackPanel.Resources>
                    <nwp:PropertyInspector Document="{Binding CustomSizeProfile}" IsResetButtonVisible="False" />
                </StackPanel>

                <Separator />

                <DockPanel Margin="0,5">
                    <nwc:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding Source={x:Static local:Config.Current}, Path=ImageTrim.IsEnabled}"
                            VerticalAlignment="Center" />
                    <TextBlock Text="{properties:TextBinding Effect.Trim}" VerticalAlignment="Center" />
                </DockPanel>

                <StackPanel Margin="10,0,0,5" Visibility="{Binding Source={x:Static local:Config.Current}, Path=ImageTrim.IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <nwp:PropertyInspector Document="{Binding TrimProfile}" IsResetButtonVisible="False" />
                </StackPanel>

                <Separator />

                <DockPanel Margin="0,5">
                    <nwc:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding Source={x:Static local:Config.Current}, Path=ImageDotKeep.IsEnabled}"
                            VerticalAlignment="Center" />
                    <TextBlock Text="{properties:TextBinding Effect.KeepDot}" VerticalAlignment="Center" />
                </DockPanel>

                <Separator />

                <DockPanel Margin="0,5">
                    <nwc:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding Source={x:Static local:Config.Current}, Path=ImageResizeFilter.IsEnabled}"
                            VerticalAlignment="Center" />
                    <TextBlock Text="{properties:TextBinding Effect.ResizeFilter}" VerticalAlignment="Center" />
                </DockPanel>

                <StackPanel Visibility="{Binding Source={x:Static local:Config.Current}, Path=ImageResizeFilter.IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">

                    <DockPanel Margin="0,5">
                        <Button DockPanel.Dock="Right" Style="{StaticResource NavigateButtonStyle}" Click="AddShaderButton_Click" ToolTip="{properties:TextBinding Word.Add}">
                            <Image Style="{StaticResource AddIconImageStyle}" />
                        </Button>
                        <ComboBox x:Name="ShaderSelector" Margin="0,0,4,0" ItemsSource="{Binding ShaderEffects}" DisplayMemberPath="Name"
                                  SelectedValuePath="RelativePath" SelectedValue="{Binding SelectedShaderPath}" MinWidth="120" />
                    </DockPanel>

                    <Border BorderBrush="{DynamicResource Control.Border}" BorderThickness="1" CornerRadius="6" Margin="0,5,0,0">
                        <ListBox x:Name="ShaderChainList" ItemsSource="{Binding ShaderChain}" AllowDrop="True" Background="Transparent" BorderThickness="0"
                                 PreviewMouseLeftButtonDown="ShaderChainList_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="ShaderChainList_PreviewMouseMove"
                                 PreviewDragOver="ShaderChainList_PreviewDragOver"
                                 Drop="ShaderChainList_Drop">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="5,3">
                                        <TextBlock DockPanel.Dock="Left" Width="22" Text="{Binding DisplayNumber}" />
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button x:Name="ShaderParameterButton" Style="{StaticResource NavigateButtonStyle}" Click="ShaderParameterButton_Click"
                                                    Visibility="{Binding HasParameters, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Image Style="{StaticResource SettingIconImageStyle}" />
                                            </Button>
                                            <Button Style="{StaticResource NavigateButtonStyle}" Command="{Binding RemoveCommand}">
                                                <Image Style="{StaticResource ClearIconImageStyle}" />
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <Popup x:Name="ShaderParameterPopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                           PopupAnimation="{DynamicResource {x:Static SystemParameters.MenuPopupAnimationKey}}">
                        <Border Background="{DynamicResource Menu.Background}" BorderBrush="{DynamicResource Menu.Border}" BorderThickness="1"
                                CornerRadius="6" Padding="10" MaxWidth="300">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedShaderChainItem.Name}" FontWeight="Bold" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding SelectedShaderChainItem.ParameterItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,3">
                                                <DockPanel>
                                                    <TextBlock Text="{Binding Label}" />
                                                    <TextBlock Text="{Binding Value, StringFormat={}{0:0.####}}" HorizontalAlignment="Right" />
                                                </DockPanel>
                                                <Slider Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Value, Mode=TwoWay}"
                                                        TickFrequency="{Binding Step}" IsSnapToTickEnabled="True" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button HorizontalAlignment="Right" Margin="0,8,0,0" Click="ShaderParameterReset_Click">
                                    <TextBlock Text="{properties:TextBinding Word.Reset}" Foreground="{DynamicResource Control.Accent}" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Button x:Name="ResetButton" Style="{StaticResource IconButton}" HorizontalAlignment="Right" Margin="5" Click="Reset">
                        <TextBlock Margin="5" Text="{properties:TextBinding Effect.ResizeReset}" Foreground="{DynamicResource Control.Accent}" />
                    </Button>
                </StackPanel>


                <Separator />

                <DockPanel Margin="0,5">
                    <nwc:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding Source={x:Static local:Config.Current}, Path=ImageGrid.IsEnabled}"
                            VerticalAlignment="Center" />
                    <TextBlock Text="{properties:TextBinding Effect.Grid}" VerticalAlignment="Center" />
                </DockPanel>

                <StackPanel Margin="10,0,0,5" Visibility="{Binding Source={x:Static local:Config.Current}, Path=ImageGrid.IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <nwp:PropertyInspector Document="{Binding GridLineProfile}" IsResetButtonVisible="True" />
                </StackPanel>

                <Separator />

                <DockPanel Margin="0,5">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource NavigateButtonStyle}" HorizontalAlignment="Left" Command="{Binding AddEffectLayerCommand}"
                                Visibility="{Binding Source={x:Static local:Config.Current}, Path=ImageEffect.IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Image Style="{StaticResource AddIconImageStyle}" />
                        </Button>
                        <nwc:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding Source={x:Static local:Config.Current}, Path=ImageEffect.IsEnabled}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{properties:TextBinding Effect.Effect}" VerticalAlignment="Center" />
                </DockPanel>

                <StackPanel Visibility="{Binding Source={x:Static local:Config.Current}, Path=ImageEffect.IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">

                    <ItemsControl ItemsSource="{Binding EffectLayers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>

                                    <DockPanel x:Name="LayerHeader" Margin="0,0,0,10" LastChildFill="True" Background="Transparent" KeyboardNavigation.TabNavigation="Local" >
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" KeyboardNavigation.TabIndex="3">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DockPanel}, Path=IsMouseOver}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource NavigateButtonStyle}" Command="{Binding MoveUpCommand}">
                                                <Image Style="{StaticResource KeyboardArrowUpIconImageStyle}" />
                                            </Button>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource NavigateButtonStyle}" Command="{Binding MoveDownCommand}">
                                                <Image Style="{StaticResource KeyboardArrowDownIconImageStyle}" />
                                            </Button>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource NavigateButtonStyle}" Command="{Binding DeleteCommand}">
                                                <Image Style="{StaticResource ClearIconImageStyle}" />
                                            </Button>
                                        </StackPanel>

                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" Width="22" TabIndex="1" />
                                        <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding EffectTypeList}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding EffectType}" TabIndex="2" />

                                    </DockPanel>

                                    <StackPanel Visibility="{Binding IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">

                                        <StackPanel HorizontalAlignment="Stretch" Margin="8,0" Visibility="{Binding EffectUnit, Converter={StaticResource EffectUnitToSampleVisibilityConverter}}">
                                            <Border Background="{Binding EffectUnit, Converter={StaticResource EffectUnitToBushConverter}}" Height="16" Margin="1" CornerRadius="4,4,0,0"/>
                                            <Border Background="{Binding EffectUnit, Converter={StaticResource EffectUnitToBushConverter}}" Height="16" Margin="1" CornerRadius="0,0,4,4"
                                            Effect="{Binding EffectUnit, Converter={StaticResource EffectUnitToEffectConverter}}"/>
                                        </StackPanel>

                                        <nwp:PropertyInspector x:Name="inspector" Document="{Binding EffectParameters}" IsResetButtonVisible="True"
                                                    Visibility="{Binding EffectParameters, Converter={StaticResource NullableToVisibilityConverter}}"
                                                    IsHsvMode="{Binding Source={x:Static local:Config.Current}, Path=ImageEffect.IsHsvMode}">
                                        </nwp:PropertyInspector>

                                    </StackPanel>

                                    <Separator/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </StackPanel>
            </StackPanel>

        </ScrollViewer>
    </DockPanel>


</UserControl>
